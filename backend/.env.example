# Example environment file for local backend development.
#
# Copy this to backend/.env and fill in real values:
#     cp backend/.env.example backend/.env
#
# backend/.env is git-ignored — NEVER commit real secrets. In production these
# are set as environment variables in the host dashboard (e.g. Render's
# Environment tab), not via a .env file. app/main.py loads backend/.env at
# startup via python-dotenv; a missing file is a harmless no-op.

# WeatherAPI.com key — the PRIMARY forecast source (key-based, so it isn't at
# the mercy of a shared-IP rate limit). Free key: https://www.weatherapi.com/
# (Free plan: 100k calls/month, 3-day forecast). If unset, the app fails soft
# and falls back to the keyless Open-Meteo connector, then to historical
# baselines — nothing breaks, you just don't get WeatherAPI as primary.
WEATHERAPI_KEY=

# Comma-separated browser origins allowed by CORS. Defaults to the local Vite
# dev server when unset. In production, set this to the deployed frontend URL.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM for POST /chat (the conversational core). PRIMARY: Google Gemini Flash —
# free key at https://aistudio.google.com. If unset, /chat still works: it
# returns a deterministic answer built from the grounded facts (never a bare
# refusal), just not rephrased into natural language.
GEMINI_API_KEY=
# Optional FALLBACK if Gemini is missing/rate-limited: Groq (free, OpenAI-
# compatible) — https://console.groq.com.
GROQ_API_KEY=
# Optional model overrides (defaults: gemini-2.0-flash / llama-3.3-70b-versatile).
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_MODEL=llama-3.3-70b-versatile
