# Copy this file to .env and fill in real values. Never commit .env itself.

# --- LLM provider (Sprint 2) — confirm choice as a team, keep both as options ---
GEMINI_API_KEY=your_key_here
GROQ_API_KEY=your_key_here

# --- Database (Sprint 1-2) — Supabase or Neon free tier ---
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- App config ---
APP_ENV=development
DEFAULT_TIMEZONE=Asia/Kolkata

# Comma-separated browser origins allowed to call the API (CORS).
# Add the deployed frontend URL here in production. Defaults to the Vite dev server.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
